# Ollama service URL
# Docker Compose: http://ollama:11434
# Local dev:      http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# Model to use for expense parsing.
# Recommended: qwen2.5:7b  (best JSON + reasoning, ~4.7 GB)
# Lighter alt:  qwen2.5:3b (~1.9 GB, fast, slightly less capable)
OLLAMA_MODEL=qwen2.5:7b

# Database URL — controls which database backend is used.
#
# SQLite  (local dev, zero setup):
DATABASE_URL=sqlite+aiosqlite:///./kharchashare.db
#
# PostgreSQL (production / shared mobile testing):
# DATABASE_URL=postgresql+asyncpg://kharchashare:password@localhost/kharchashare
